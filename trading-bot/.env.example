# Copy this file to .env and fill in your own Alpaca keys.
# .env is gitignored — never commit real credentials.
#
# Get these from your Alpaca dashboard (app.alpaca.markets):
# start with the PAPER keys shown by default; switch to LIVE keys only
# when you're ready to use `live-trade --live --confirm-real-money`.

ALPACA_API_KEY_ID=your-key-id-here
ALPACA_API_SECRET_KEY=your-secret-key-here
